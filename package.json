{
  "name": "clinic-web",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "dev:landing": "turbo run dev --filter=landing",
    "dev:demo": "turbo run dev --filter=clinic-demo",
    "dev:agency": "turbo run dev --filter=agency-demo",
    "dev:full": "turbo run dev --filter=clinic-full-demo",
    "dev:branch": "turbo run dev --filter=clinic-branch-demo"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
